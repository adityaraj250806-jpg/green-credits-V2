{
  "version": 2,
  "builds": [
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://green-credits-hmj9.onrender.com/api/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "https://green-credits-hmj9.onrender.com/uploads/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
